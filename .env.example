# Copy to .env.local and fill in. Never commit .env.local.

# Square access token. Get sandbox and production tokens from
# developer.squareup.com/apps -> your app -> Credentials.
# Use the sandbox token until you're ready to take real money.
SQUARE_ACCESS_TOKEN=EAAAExxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Square environment the access token above belongs to.
# "sandbox" (default if unset) or "production".
SQUARE_ENVIRONMENT=sandbox

# The Square location the order is placed against. Find it at
# developer.squareup.com/apps -> your app -> Credentials -> Location ID,
# or via the Locations API. A sandbox token needs a sandbox location id;
# a production token needs the real location id from her Square dashboard.
SQUARE_LOCATION_ID=L_replace_me

# The site's public origin. Used to build the checkout redirect URL.
# Set this to https://marlipan.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
