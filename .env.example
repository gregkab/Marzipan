# Copy to .env.local and fill in. Never commit .env.local.

# Stripe secret key. Use the test key (sk_test_...) until you're ready to take
# real money, then swap in the live key (sk_live_...) in Vercel's env settings.
STRIPE_SECRET_KEY=sk_test_replace_me

# The site's public origin. Used to build absolute URLs for Stripe redirects
# and product images. Set this to https://marlipan.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
